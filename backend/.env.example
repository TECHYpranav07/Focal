# ─────────────────────────────────────────────────────────────────────────────
# Focal Backend Environment Variables Example
# Copy this file to '.env' and modify the values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# Required in production, optional/defaulted in local dev when DEBUG=true
SECRET_KEY=your-secure-random-key-here

# General Configuration
DEBUG=true
PORT=7860
DATABASE_URL=sqlite+aiosqlite:///./focal.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads

# Face Recognition Settings
RECOGNITION_MODEL=ArcFace
DETECTOR_BACKEND=retinaface
SIMILARITY_THRESHOLD=0.38
FALLBACK_THRESHOLD=0.32
INSURANCE_THRESHOLD=0.28
ENABLE_INSURANCE_MATCHING=true

# Migrations & Safety
ALLOW_DESTRUCTIVE_MIGRATION=false
